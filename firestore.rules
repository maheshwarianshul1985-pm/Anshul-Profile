rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /portfolio/{docId} {
      allow read: if true;
      allow write: if true; // Demo mode, anyone can update the portfolio
    }

    match /agent_cache/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /analytics/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /agent_chats/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /telemetry_logs/{docId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
